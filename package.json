{
  "name": "@tsfg/agent-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "format:check": "node tools/agent-infra.ts format",
    "license:check": "node tools/agent-infra.ts license-policy",
    "secret:scan": "node tools/agent-infra.ts secret-scan",
    "source:check": "node tools/agent-infra.ts source-integrity",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "workflow:check": "node tools/agent-infra.ts workflow-policy",
    "verify": "node tools/agent-infra.ts format && tsc --noEmit && node --test tests/*.test.ts && node tools/agent-infra.ts secret-scan && node tools/agent-infra.ts source-integrity && node tools/agent-infra.ts license-policy && node tools/agent-infra.ts workflow-policy"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
