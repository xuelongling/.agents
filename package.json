{
  "name": "@tsfg/agent-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "format:check": "node tools/agent-infra.ts format",
    "secret:scan": "node tools/agent-infra.ts secret-scan",
    "source:check": "node tools/agent-infra.ts source-integrity",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm secret:scan && pnpm source:check"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
